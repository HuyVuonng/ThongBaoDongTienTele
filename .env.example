# Cấu hình máy chủ
PORT=3000
NODE_ENV=development

# Mật khẩu quản trị Dashboard (Đổi khi đưa lên production)
ADMIN_PASSWORD=admin123456

# Chuỗi bí mật phiên đăng nhập
SESSION_SECRET=super_secret_session_key_change_me_in_production_12345

# Telegram Bot Token (Lấy từ @BotFather trên Telegram)
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Telegram Admin ID (Lấy từ bot /chatid hoặc @userinfobot)
TELEGRAM_ADMIN_ID=

# Cấu hình SePay Webhook
# API Key hoặc Secret Token dùng để xác thực webhook gửi từ SePay (nếu cấu hình trong SePay)
SEPAY_WEBHOOK_SECRET=

# Đường dẫn lưu trữ dữ liệu JSON (Mặc định: ./data/state.json, trên Render gắn Persistent Disk: /var/data/state.json)
DATA_PATH=./data/state.json

# Timezone (Mặc định: Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh

# Webhook Public URL (Khi deploy trên Render / VPS có domain HTTPS để dùng Telegram webhook nếu muốn)
PUBLIC_URL=
